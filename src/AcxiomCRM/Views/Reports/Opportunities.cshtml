@model ReportPage<OpportunityReportRow>
@{
    ViewData["Title"] = Model.Title;
    var header = new ReportHeaderView
    {
        Title = Model.Title,
        Description = Model.Description,
        Summary = Model.Summary,
        Exports = { ("Export CSV", Html.UrlWith(new Dictionary<string, string?> { ["export"] = "csv", ["page"] = null })) }
    };
    var filters = new ReportFilterView
    {
        Filter = Model.Filter,
        Owners = Model.Owners,
        DateLabel = "Expected close",
        Stages = Enum.GetNames<OpportunityStage>(),
        Statuses = Enum.GetNames<OpportunityStatus>()
    };
}
<partial name="_ReportHeader" model="header" />
<partial name="_ReportFilters" model="filters" />
<div class="card">
    <div class="table-responsive">
        <table class="table table-crm">
            <thead>
                <tr>
                    <th>@Html.SortLink("Opportunity", "name")</th><th>Customer</th><th>@Html.SortLink("Stage", "stage")</th>
                    <th class="text-end">@Html.SortLink("Amount", "amount")</th><th class="text-end">@Html.SortLink("Probability", "probability")</th>
                    <th class="text-end">Weighted</th><th>@Html.SortLink("Expected close", "close")</th><th>Owner</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows.Items)
                {
                    <tr>
                        <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@r.Id">@r.Name</a></td>
                        <td>@r.Customer</td>
                        <td>@StatusBadge(r.Stage)</td>
                        <td class="text-end">@Money(r.Amount)</td>
                        <td class="text-end">@r.Probability%</td>
                        <td class="text-end">@Money(r.Weighted)</td>
                        <td class="text-nowrap">@Date(r.ExpectedCloseDate)</td>
                        <td>@r.Owner</td>
                    </tr>
                }
                @if (Model.Rows.TotalCount == 0)
                {
                    <tr><td colspan="8" class="empty-state">No opportunities match the filters.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="@PagerModel.From(Model.Rows, "opportunities")" />
</div>
