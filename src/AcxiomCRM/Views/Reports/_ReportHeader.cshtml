@model ReportHeaderView
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index">Reports</a></li><li class="breadcrumb-item active" aria-current="page">@Model.Title</li></ol></nav>
        <h1>@Model.Title</h1>
        <div class="subtitle">@Model.Description</div>
    </div>
    <div class="d-flex gap-2">
        @foreach (var (label, url) in Model.Exports)
        {
            <a href="@url" class="btn btn-light border"><i class="bi bi-download me-1" aria-hidden="true"></i>@label</a>
        }
        <button type="button" class="btn btn-light border" onclick="window.print()"><i class="bi bi-printer me-1" aria-hidden="true"></i>Print</button>
    </div>
</div>
@if (Model.Summary.Count > 0)
{
    <div class="row g-3 mb-3">
        @foreach (var s in Model.Summary)
        {
            <div class="col-6 col-md-4 col-xl">
                <div class="kpi-card">
                    <div class="kpi-label">@s.Label</div>
                    <div class="kpi-value" style="font-size:1.25rem">@s.Value</div>
                    @if (s.Hint != null)
                    {
                        <div class="kpi-hint">@s.Hint</div>
                    }
                </div>
            </div>
        }
    </div>
}
