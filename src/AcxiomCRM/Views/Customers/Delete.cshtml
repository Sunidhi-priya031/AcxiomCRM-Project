@model CustomerDeleteViewModel
@{
    ViewData["Title"] = "Delete customer";
    var c = Model.Customer;
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Customers</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@c.CustomerId">@c.CustomerCode</a></li><li class="breadcrumb-item active" aria-current="page">Delete</li></ol></nav>
        <h1>Delete customer</h1>
    </div>
</div>
<div class="card" style="max-width: 640px">
    <div class="card-body">
        <dl class="detail-list mb-3">
            <dt>Customer</dt><dd>@c.CustomerName (@c.CustomerCode)</dd>
            <dt>Company</dt><dd>@(c.CompanyName ?? "-")</dd>
            <dt>Email / Phone</dt><dd>@c.Email · @c.Phone</dd>
            <dt>Status</dt><dd>@StatusBadge(c.Status)</dd>
        </dl>
        @if (Model.RelatedCount > 0)
        {
            <div class="alert alert-warning small mb-0" role="alert">
                This customer has @Model.RelatedCount related record(s) (opportunities, follow-ups, activities or converted leads).
                To keep that history, the customer will be <strong>deactivated</strong> instead of deleted.
            </div>
        }
        else
        {
            <div class="alert alert-danger small mb-0" role="alert">This customer has no related records and will be permanently deleted. This cannot be undone.</div>
        }
    </div>
    <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post"
          data-confirm="@(Model.RelatedCount > 0 ? $"Deactivate {c.CustomerName}?" : $"Permanently delete {c.CustomerName}?")"
          data-confirm-button="@(Model.RelatedCount > 0 ? "Deactivate" : "Delete")">
        <div class="form-actions">
            <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-danger">@(Model.RelatedCount > 0 ? "Deactivate customer" : "Delete customer")</button>
        </div>
    </form>
</div>
