@model OpportunityFormViewModel
<div class="card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="form-section-title">Opportunity</div>
    <div class="row g-3">
        <div class="col-md-12">
            <label asp-for="OpportunityName" class="form-label required"></label>
            <input asp-for="OpportunityName" class="form-control" maxlength="150" />
            <span asp-validation-for="OpportunityName"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CustomerId" class="form-label required"></label>
            <select asp-for="CustomerId" asp-items="Model.CustomerOptions" class="form-select">
                <option value="">Select a customer…</option>
            </select>
            <span asp-validation-for="CustomerId"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LeadId" class="form-label">Originating lead</label>
            <select asp-for="LeadId" asp-items="Model.LeadOptions" class="form-select">
                <option value="">None</option>
            </select>
            <span asp-validation-for="LeadId"></span>
        </div>
    </div>

    <div class="form-section-title">Value &amp; stage</div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Amount" class="form-label required">Amount (₹)</label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Amount"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Stage" class="form-label required"></label>
            <select asp-for="Stage" asp-items="Model.StageOptions" class="form-select" id="Stage"></select>
            <span asp-validation-for="Stage"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Probability" class="form-label required"></label>
            <input asp-for="Probability" class="form-control" type="number" step="1" />
            <span asp-validation-for="Probability"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="ExpectedCloseDate" class="form-label required"></label>
            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
            <span asp-validation-for="ExpectedCloseDate"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Source" class="form-label"></label>
            <select asp-for="Source" asp-items="Html.GetEnumSelectList<LeadSource>()" class="form-select">
                <option value="">Not specified</option>
            </select>
            <span asp-validation-for="Source"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="AssignedTo" class="form-label"></label>
            @if (Model.CanChooseAssignee)
            {
                <select asp-for="AssignedTo" asp-items="Model.AssignableUsers" class="form-select"></select>
            }
            else
            {
                <input type="hidden" asp-for="AssignedTo" />
                <select class="form-select" disabled asp-items="Model.AssignableUsers"></select>
            }
            <span asp-validation-for="AssignedTo"></span>
        </div>
        <div class="col-12">
            <div class="small text-body-secondary" id="weightedPreview" aria-live="polite"></div>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
            <span asp-validation-for="Notes"></span>
        </div>
    </div>
</div>
<script>
    (function () {
        var amount = document.getElementById("Amount"), prob = document.getElementById("Probability"), out = document.getElementById("weightedPreview");
        var fmt = new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 });
        function update() {
            var a = parseFloat(amount.value), p = parseInt(prob.value, 10);
            out.textContent = (a > 0 && p >= 0 && p <= 100) ? "Weighted amount: " + fmt.format(a * p / 100) : "";
        }
        amount.addEventListener("input", update); prob.addEventListener("input", update); update();
    })();
</script>
