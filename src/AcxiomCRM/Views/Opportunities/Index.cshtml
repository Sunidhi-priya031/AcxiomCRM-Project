@model OpportunityIndexViewModel
@{
    ViewData["Title"] = "Opportunities";
    var s = Model.Search;
}
<div class="page-header">
    <div>
        <h1>Opportunities</h1>
        <div class="subtitle">Sales opportunities with amount, probability and stage</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Pipeline" class="btn btn-light border"><i class="bi bi-kanban me-1" aria-hidden="true"></i>Pipeline view</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>New opportunity</a>
    </div>
</div>

<form method="get" class="filter-bar" role="search" aria-label="Filter opportunities">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="q">Search</label>
            <input type="search" id="q" name="q" value="@s.Q" class="form-control form-control-sm" placeholder="Opportunity or customer name" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="stage">Stage</label>
            <select id="stage" name="stage" class="form-select form-select-sm" data-autosubmit>
                <option value="">All</option>
                @foreach (var st in Enum.GetValues<OpportunityStage>())
                {
                    <option value="@st" selected="@(s.Stage == st)">@st</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="status">Status</label>
            <select id="status" name="status" class="form-select form-select-sm" data-autosubmit>
                <option value="">All</option>
                @foreach (var st in Enum.GetValues<OpportunityStatus>())
                {
                    <option value="@st" selected="@(s.Status == st)">@st</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="assignedTo">Owner</label>
            <select id="assignedTo" name="assignedTo" class="form-select form-select-sm" data-autosubmit>
                <option value="">All owners</option>
                @foreach (var u in Model.Owners)
                {
                    <option value="@u.Id" selected="@(s.AssignedTo == u.Id)">@u.FullName</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2 d-flex gap-2">
            <input type="hidden" name="sort" value="@s.Sort" />
            @if (s.CustomerId.HasValue)
            {
                <input type="hidden" name="customerId" value="@s.CustomerId" />
            }
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search me-1" aria-hidden="true"></i>Search</button>
            <a asp-action="Index" class="btn btn-sm btn-light border">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    @if (Model.Results.TotalCount == 0)
    {
        <div class="empty-state"><i class="bi bi-briefcase" aria-hidden="true"></i>No opportunities match your filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-crm">
                <thead>
                    <tr>
                        <th>@Html.SortLink("Opportunity", "name")</th>
                        <th>Customer</th>
                        <th>@Html.SortLink("Stage", "stage")</th>
                        <th class="text-end">@Html.SortLink("Amount", "amount")</th>
                        <th class="text-end">@Html.SortLink("Prob.", "probability")</th>
                        <th class="text-end">Weighted</th>
                        <th>@Html.SortLink("Expected close", "close")</th>
                        <th>Owner</th>
                        <th class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Results.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-medium">@o.OpportunityName</a></td>
                            <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.Customer?.CustomerName</a></td>
                            <td>@StatusBadge(o.Stage)</td>
                            <td class="text-end">@Money(o.Amount)</td>
                            <td class="text-end">@o.Probability%</td>
                            <td class="text-end">@Money(o.WeightedAmount)</td>
                            <td class="text-nowrap @(o.IsOpen && o.ExpectedCloseDate < DateTime.Today ? "text-danger" : "")">@Date(o.ExpectedCloseDate)</td>
                            <td>@o.AssignedToUser?.FullName</td>
                            <td class="text-end text-nowrap">
                                @if (o.IsOpen)
                                {
                                    <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-sm btn-light border" aria-label="Edit @o.OpportunityName"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                }
                                @if (Model.CanDelete)
                                {
                                    <a asp-action="Delete" asp-route-id="@o.OpportunityId" class="btn btn-sm btn-light border text-danger" aria-label="Delete @o.OpportunityName"><i class="bi bi-trash" aria-hidden="true"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model='PagerModel.From(Model.Results, "opportunities")' />
</div>
