@{
    ViewData["Title"] = "Access denied";
    if (User.Identity?.IsAuthenticated != true)
    {
        Layout = "_AuthLayout";
    }
}
<div class="card mx-auto" style="max-width: 560px">
    <div class="card-body text-center py-5">
        <i class="bi bi-shield-lock fs-1 text-danger" aria-hidden="true"></i>
        <h1 class="h5 fw-semibold mt-3">You don't have access to this page</h1>
        <p class="text-body-secondary mb-4">Your role does not allow this action, or the record is outside your assigned scope. The attempt has been recorded.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Back to dashboard</a>
    </div>
</div>
