@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}
<div class="page-header">
    <div>
        <h1>Change password</h1>
        <div class="subtitle">Choose a strong password you don't use elsewhere.</div>
    </div>
</div>

<div class="card" style="max-width: 560px">
    <form asp-action="ChangePassword" method="post" novalidate>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label required"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="pwdHelp" />
                <div id="pwdHelp" class="form-text">At least 8 characters with upper- and lower-case letters, a number and a symbol.</div>
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="mb-1">
                <label asp-for="ConfirmPassword" class="form-label required"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <div class="form-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
