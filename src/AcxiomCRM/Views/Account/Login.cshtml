@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<h1 class="h5 fw-semibold mb-1">Sign in</h1>
<p class="text-body-secondary small mb-4">Use your work email and password.</p>

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="email" autocomplete="username" autofocus />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Sign in</button>
</form>

<p class="small text-center mt-4 mb-0">
    New to AcxiomCRM? <a asp-action="Register">Create an account</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
