@model LeadFormViewModel
<div class="card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <div class="form-section-title">Lead</div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="LeadName" class="form-label required"></label>
            <input asp-for="LeadName" class="form-control" maxlength="100" />
            <span asp-validation-for="LeadName"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CompanyName" class="form-label"></label>
            <input asp-for="CompanyName" class="form-control" maxlength="150" />
            <span asp-validation-for="CompanyName"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" maxlength="256" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" type="tel" inputmode="numeric" maxlength="10" placeholder="10-digit mobile number" />
            <span asp-validation-for="Phone"></span>
        </div>
    </div>

    <div class="form-section-title">Qualification</div>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Source" class="form-label required"></label>
            <select asp-for="Source" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()"></select>
            <span asp-validation-for="Source"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Status" class="form-label required"></label>
            <select asp-for="Status" class="form-select" asp-items="Model.StatusOptions"></select>
            <span asp-validation-for="Status"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Priority" class="form-label required"></label>
            <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<LeadPriority>()"></select>
            <span asp-validation-for="Priority"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ExpectedValue" class="form-label required">Expected Value (₹)</label>
            <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="ExpectedValue"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AssignedTo" class="form-label"></label>
            @if (Model.CanChooseAssignee)
            {
                <select asp-for="AssignedTo" asp-items="Model.AssignableUsers" class="form-select"></select>
            }
            else
            {
                <input type="hidden" asp-for="AssignedTo" />
                <select class="form-select" disabled asp-items="Model.AssignableUsers"></select>
            }
            <span asp-validation-for="AssignedTo"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
            <span asp-validation-for="Notes"></span>
        </div>
    </div>
</div>
