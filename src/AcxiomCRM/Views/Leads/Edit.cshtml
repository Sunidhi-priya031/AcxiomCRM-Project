@model LeadFormViewModel
@{
    ViewData["Title"] = "Edit lead";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Leads</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.LeadId">@Model.LeadCode</a></li><li class="breadcrumb-item active" aria-current="page">Edit</li></ol></nav>
        <h1>Edit lead</h1>
        <div class="subtitle">Status options follow the lead workflow. Converted can only be reached with Convert.</div>
    </div>
</div>
<div class="card" style="max-width: 900px">
    <form asp-action="Edit" asp-route-id="@Model.LeadId" method="post" novalidate>
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
