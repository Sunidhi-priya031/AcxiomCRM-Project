@model LeadConvertViewModel
@{
    ViewData["Title"] = "Convert lead";
    var l = Model.Lead;
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Leads</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@l.LeadId">@l.LeadCode</a></li><li class="breadcrumb-item active" aria-current="page">Convert</li></ol></nav>
        <h1>Convert lead: @l.LeadName</h1>
        <div class="subtitle">Creates or links a customer and, optionally, an opportunity. The lead is then marked Converted.</div>
    </div>
</div>

<div class="card" style="max-width: 900px">
    <form asp-action="Convert" asp-route-id="@l.LeadId" method="post" novalidate
          data-confirm="Convert this lead? The lead becomes read-only after conversion." data-confirm-button="Convert" data-confirm-style="btn-success">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <fieldset>
                <legend class="form-section-title">Customer</legend>
                <div class="d-flex flex-wrap gap-4 mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="CreateNewCustomer" id="newCustomer" value="true" checked="@Model.CreateNewCustomer" />
                        <label class="form-check-label" for="newCustomer">Create a new customer</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="CreateNewCustomer" id="existingCustomer" value="false" checked="@(!Model.CreateNewCustomer)" />
                        <label class="form-check-label" for="existingCustomer">Link to an existing customer</label>
                    </div>
                </div>

                <div data-show-when="CreateNewCustomer=true">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label required"></label>
                            <input asp-for="CustomerName" class="form-control" maxlength="100" />
                            <span asp-validation-for="CustomerName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label"></label>
                            <input asp-for="CompanyName" class="form-control" maxlength="150" />
                            <span asp-validation-for="CompanyName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label required"></label>
                            <input asp-for="Email" class="form-control" type="email" maxlength="256" />
                            <span asp-validation-for="Email"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label required"></label>
                            <input asp-for="Phone" class="form-control" type="tel" inputmode="numeric" maxlength="10" />
                            <span asp-validation-for="Phone"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" maxlength="250" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="State" class="form-label"></label>
                            <input asp-for="State" class="form-control" maxlength="100" />
                        </div>
                    </div>
                </div>

                <div data-show-when="CreateNewCustomer=false">
                    <label asp-for="ExistingCustomerId" class="form-label required"></label>
                    <select asp-for="ExistingCustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">Select a customer…</option>
                    </select>
                    <span asp-validation-for="ExistingCustomerId"></span>
                </div>
            </fieldset>

            <fieldset class="mt-2">
                <legend class="form-section-title">Opportunity</legend>
                <div class="form-check mb-3">
                    <input asp-for="CreateOpportunity" class="form-check-input" />
                    <label asp-for="CreateOpportunity" class="form-check-label">Create an opportunity for this customer</label>
                </div>
                <div data-show-when="CreateOpportunity=true">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label required"></label>
                            <input asp-for="OpportunityName" class="form-control" maxlength="150" />
                            <span asp-validation-for="OpportunityName"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label"></label>
                            <select asp-for="Stage" asp-items="Model.StageOptions" class="form-select"></select>
                            <span asp-validation-for="Stage"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label required">Amount (₹)</label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Amount"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label required"></label>
                            <input asp-for="Probability" class="form-control" type="number" step="1" />
                            <span asp-validation-for="Probability"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label required"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate"></span>
                        </div>
                    </div>
                </div>
            </fieldset>
        </div>
        <div class="form-actions">
            <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-success">Convert lead</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
