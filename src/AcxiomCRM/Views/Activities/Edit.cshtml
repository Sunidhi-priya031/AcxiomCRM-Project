@model ActivityFormViewModel
@{
    ViewData["Title"] = "Edit activity";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Activities</a></li><li class="breadcrumb-item active" aria-current="page">Edit</li></ol></nav>
        <h1>Edit activity</h1>
    </div>
</div>
<div class="card" style="max-width: 900px">
    <form asp-action="Edit" asp-route-id="@Model.ActivityId" method="post" novalidate>
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
