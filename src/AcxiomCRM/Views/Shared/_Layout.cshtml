@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isManager = User.IsInRole(AppRoles.Manager);
    var displayName = User.FindFirst(AppClaimsPrincipalFactory.FullNameClaim)?.Value ?? User.Identity?.Name;
    var roleName = isAdmin ? AppRoles.Admin : isManager ? AppRoles.Manager : AppRoles.SalesExecutive;
    string Active(string c, string? a = null) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) && (a == null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    string AriaCurrent(string c, string? a = null) => Active(c, a) == "active" ? "page" : "false";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AcxiomCRM</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">Skip to main content</a>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
                    <span class="brand-mark" aria-hidden="true">A</span>
                    <span class="brand-text">AcxiomCRM</span>
                </a>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section">Overview</div>
                <a class="nav-item @Active("Dashboard")" aria-current="@AriaCurrent("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</a>

                <div class="nav-section">Sales</div>
                <a class="nav-item @Active("Customers")" aria-current="@AriaCurrent("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-building" aria-hidden="true"></i> Customers</a>
                <a class="nav-item @Active("Leads")" aria-current="@AriaCurrent("Leads")" asp-controller="Leads" asp-action="Index"><i class="bi bi-funnel" aria-hidden="true"></i> Leads</a>
                <a class="nav-item @(Active("Opportunities") == "active" && action != "Pipeline" ? "active" : "")" asp-controller="Opportunities" asp-action="Index"><i class="bi bi-briefcase" aria-hidden="true"></i> Opportunities</a>
                <a class="nav-item @Active("Opportunities", "Pipeline")" aria-current="@AriaCurrent("Opportunities", "Pipeline")" asp-controller="Opportunities" asp-action="Pipeline"><i class="bi bi-kanban" aria-hidden="true"></i> Sales Pipeline</a>

                <div class="nav-section">Engagement</div>
                <a class="nav-item @Active("FollowUps")" aria-current="@AriaCurrent("FollowUps")" asp-controller="FollowUps" asp-action="Index"><i class="bi bi-calendar-check" aria-hidden="true"></i> Follow-Ups</a>
                <a class="nav-item @Active("Activities")" aria-current="@AriaCurrent("Activities")" asp-controller="Activities" asp-action="Index"><i class="bi bi-activity" aria-hidden="true"></i> Activities</a>

                <div class="nav-section">Insights</div>
                <a class="nav-item @Active("Reports")" aria-current="@AriaCurrent("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Reports</a>

                @if (isAdmin || isManager)
                {
                    <div class="nav-section">Administration</div>
                    <a class="nav-item @Active("Users")" aria-current="@AriaCurrent("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear" aria-hidden="true"></i> @(isAdmin ? "Users" : "My Team")</a>
                }
                @if (isAdmin)
                {
                    <a class="nav-item @Active("Roles")" aria-current="@AriaCurrent("Roles")" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock" aria-hidden="true"></i> Roles &amp; Permissions</a>
                    <a class="nav-item @Active("AuditLogs")" aria-current="@AriaCurrent("AuditLogs")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text" aria-hidden="true"></i> Audit Log</a>
                }
            </nav>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>

        <div class="app-main">
            <header class="topbar">
                <button type="button" class="btn btn-icon d-lg-none" id="sidebarToggle" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4" aria-hidden="true"></i>
                </button>
                <div class="topbar-title text-truncate">@ViewData["Title"]</div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    @await Component.InvokeAsync("Notifications")
                    <div class="dropdown">
                        <button class="btn user-menu-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar" aria-hidden="true">@Initials(displayName)</span>
                            <span class="d-none d-md-inline text-start lh-sm">
                                <span class="d-block small fw-semibold">@displayName</span>
                                <span class="d-block text-body-secondary" style="font-size:.75rem">@AppRoles.DisplayName(roleName)</span>
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2" aria-hidden="true"></i>Change password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content" id="main-content" tabindex="-1">
                <partial name="_Alerts" />
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year AcxiomCRM</span>
                <span class="text-body-tertiary">Signed in as @User.Identity?.Name</span>
            </footer>
        </div>
    </div>

    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
