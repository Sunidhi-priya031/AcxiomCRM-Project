@model FollowUpFormViewModel
<div class="card-body">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

    <fieldset>
        <legend class="form-section-title">Related to</legend>
        <div class="d-flex flex-wrap gap-4 mb-3">
            @foreach (var type in new[] { "Customer", "Lead", "Opportunity" })
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="RelatedType" id="rel-@type" value="@type" checked="@(Model.RelatedType == type)" />
                    <label class="form-check-label" for="rel-@type">@type</label>
                </div>
            }
        </div>
        <div data-show-when="RelatedType=Customer">
            <label asp-for="CustomerId" class="form-label required"></label>
            <select asp-for="CustomerId" asp-items="Model.CustomerOptions" class="form-select"><option value="">Select a customer…</option></select>
            <span asp-validation-for="CustomerId"></span>
        </div>
        <div data-show-when="RelatedType=Lead">
            <label asp-for="LeadId" class="form-label required"></label>
            <select asp-for="LeadId" asp-items="Model.LeadOptions" class="form-select"><option value="">Select a lead…</option></select>
            <span asp-validation-for="LeadId"></span>
        </div>
        <div data-show-when="RelatedType=Opportunity">
            <label asp-for="OpportunityId" class="form-label required"></label>
            <select asp-for="OpportunityId" asp-items="Model.OpportunityOptions" class="form-select"><option value="">Select an opportunity…</option></select>
            <span asp-validation-for="OpportunityId"></span>
        </div>
    </fieldset>

    <div class="form-section-title">Follow-up</div>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Subject" class="form-label required"></label>
            <input asp-for="Subject" class="form-control" maxlength="150" />
            <span asp-validation-for="Subject"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="FollowUpType" class="form-label required"></label>
            <select asp-for="FollowUpType" asp-items="Html.GetEnumSelectList<FollowUpType>()" class="form-select"></select>
            <span asp-validation-for="FollowUpType"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FollowUpDate" class="form-label required"></label>
            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="FollowUpDate"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AssignedTo" class="form-label"></label>
            @if (Model.CanChooseAssignee)
            {
                <select asp-for="AssignedTo" asp-items="Model.AssignableUsers" class="form-select"></select>
            }
            else
            {
                <input type="hidden" asp-for="AssignedTo" />
                <select class="form-select" disabled asp-items="Model.AssignableUsers"></select>
            }
            <span asp-validation-for="AssignedTo"></span>
        </div>
        <div class="col-12">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control" rows="3" maxlength="1000"></textarea>
            <span asp-validation-for="Remarks"></span>
        </div>
    </div>
</div>
