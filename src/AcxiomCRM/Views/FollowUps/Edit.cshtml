@model FollowUpFormViewModel
@{
    ViewData["Title"] = "Edit follow-up";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Follow-ups</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.FollowUpId">@Model.Subject</a></li><li class="breadcrumb-item active" aria-current="page">Edit</li></ol></nav>
        <h1>Edit follow-up</h1>
        <div class="subtitle">Changing the date reschedules the follow-up and is recorded in its history.</div>
    </div>
</div>
<div class="card" style="max-width: 900px">
    <form asp-action="Edit" asp-route-id="@Model.FollowUpId" method="post" novalidate>
        <input type="hidden" asp-for="FollowUpId" />
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <a asp-action="Details" asp-route-id="@Model.FollowUpId" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
