@model UserFormViewModel
@{
    ViewData["Title"] = "Edit user";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Users</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.FullName</a></li><li class="breadcrumb-item active" aria-current="page">Edit</li></ol></nav>
        <h1>Edit user</h1>
        <div class="subtitle">Role and status changes take effect immediately and are recorded in the audit log.</div>
    </div>
</div>
<div class="card" style="max-width: 820px">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
        <input type="hidden" asp-for="Id" />
        <partial name="_Form" model="Model" />
        <div class="form-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
