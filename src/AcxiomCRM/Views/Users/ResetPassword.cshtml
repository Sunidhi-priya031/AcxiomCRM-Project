@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb small mb-1"><li class="breadcrumb-item"><a asp-action="Index">Users</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.FullName</a></li><li class="breadcrumb-item active" aria-current="page">Reset password</li></ol></nav>
        <h1>Reset password</h1>
        <div class="subtitle">@Model.FullName (@Model.Email). The new password must meet the password policy. Existing sessions are ended.</div>
    </div>
</div>
<div class="card" style="max-width: 560px">
    <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" novalidate>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="form-label required"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <div class="form-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light border">Cancel</a>
            <button type="submit" class="btn btn-primary">Reset password</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
